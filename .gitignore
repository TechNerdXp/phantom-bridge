# Runtime state and telemetry. The JSONL logs carry the inverter's serial
# numbers in their QID/QSID replies, so the whole directory stays out --
# ignoring only *.jsonl left logs/state.json and logs/handover.json committable.
logs/

# Real site identifiers. See config.py for what the placeholders mean.
config.local.py

# The owner's running notes for the next session.
scratchpad.md

__pycache__/
*.pyc
*.pyo
*.db
.venv/
.env

# PyInstaller. dist\PhantomBridge\ is the installation but it is rebuilt,
# not committed; icon.ico is committed because the spec needs it to build.
build/
dist/
*.spec.bak
